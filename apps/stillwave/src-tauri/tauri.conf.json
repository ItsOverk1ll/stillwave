{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stillwave",
  "version": "0.0.1",
  "identifier": "org.stillwave.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stillwave",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "The Stillwave contributors",
    "category": "Music",
    "shortDescription": "Your music, your files, bit-perfect.",
    "longDescription": "Stillwave is an open-source music player for music you own: synced playlists, mixes and radio on top of bit-perfect playback of your own files.",
    "license": "GPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
